.DS_Store

# Local Claude config — gitignore everything by default,
# then un-ignore the shareable artifacts below.
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/commands/

# Per-machine Claude state (always local)
.claude/agents/*.local.md
.claude/skills/**/state.json
.claude/skills/**/reviews/

# Playwright + screenshot artifacts (session-local)
.playwright-mcp/
day*-*.png
img-*.png
doc-*.png
*-fullpage.png
*-current.png
*-snapshot.md
day*-iter*-fresh-*.md
day*-iter*-audit-*.md
# Loose playwright screenshots (any image at repo root that's clearly a session capture)
/lodging-*.png
/lodging-*.jpg
/sky-*.png
/sky-*.jpg
/*-klook.jpg
/*-klook.png
