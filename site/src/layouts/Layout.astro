---
export interface Props {
  title: string;
  hideNav?: boolean;
  bodyClass?: string;
}
const { title, hideNav = false, bodyClass = '' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#b91c1c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Japan 2026" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/icons/icon-192.png`} />
    <link rel="apple-touch-icon" href={`${base}/icons/icon-192.png`} />
    <title>{title} · Japan 2026</title>
    <style is:global>
      :root {
        --bg: #0f172a;
        --surface: #1e293b;
        --surface-2: #334155;
        --text: #f1f5f9;
        --muted: #94a3b8;
        --accent: #b91c1c;
        --accent-2: #ef4444;
        --ok: #16a34a;
        --warn: #ca8a04;
        --border: #334155;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.5;
        min-height: 100vh;
        padding-bottom: env(safe-area-inset-bottom);
      }
      a { color: var(--accent-2); text-decoration: none; }
      a:hover { text-decoration: underline; }
      h1, h2, h3 { line-height: 1.2; margin: 0 0 0.5em; }
      h1 { font-size: 1.75rem; }
      h2 { font-size: 1.3rem; color: var(--accent-2); }
      h3 { font-size: 1.05rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
      .container { max-width: 720px; margin: 0 auto; padding: 1rem; padding-top: max(1rem, env(safe-area-inset-top)); }
      header.app-nav {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0.75rem 1rem;
        padding-top: max(0.75rem, env(safe-area-inset-top));
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      header.app-nav a.brand { color: var(--text); font-weight: 600; font-size: 1.05rem; }
      header.app-nav nav { display: flex; gap: 0.5rem; font-size: 0.85rem; }
      header.app-nav nav a { color: var(--muted); }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 0.75rem;
        display: block;
        color: var(--text);
      }
      .card:hover { text-decoration: none; border-color: var(--accent); }
      .card .hint { color: var(--muted); font-size: 0.85rem; margin-top: 0.25rem; }
      .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
      .grid-2 > .card { margin-bottom: 0; }
      .pill { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; background: var(--surface-2); color: var(--muted); }
      .pill.locked { background: #7f1d1d; color: #fecaca; }
      .pill.ok { background: #14532d; color: #bbf7d0; }
      .pill.warn { background: #713f12; color: #fde68a; }
      table { width: 100%; border-collapse: collapse; margin: 0.5rem 0; font-size: 0.9rem; }
      th, td { text-align: left; padding: 0.5rem 0.4rem; border-bottom: 1px solid var(--border); vertical-align: top; }
      th { color: var(--muted); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; }
      code { background: var(--surface-2); padding: 1px 6px; border-radius: 4px; font-size: 0.85em; }
      ul { padding-left: 1.25rem; margin: 0.5rem 0; }
      li { margin: 0.25rem 0; }
      .copy-btn {
        background: var(--surface-2);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
        cursor: pointer;
        margin-left: 0.5rem;
      }
      .copy-btn:active { background: var(--accent); }
      .lang-ja { font-family: "Hiragino Sans", "Yu Gothic", sans-serif; }
      #gate-fail { padding: 3rem 1rem; text-align: center; color: var(--muted); }
      .hidden { display: none !important; }
    </style>
  </head>
  <body class={bodyClass}>
    <!-- Token gate: site renders only when ?k=<token> matches. -->
    <div id="gate-fail" class="hidden">
      <h1>Japan 2026</h1>
      <p>Open this page from the bookmarked link.</p>
    </div>
    <div id="app-root">
      {!hideNav && (
        <header class="app-nav">
          <a href={`${base}/`} class="brand">🗾 Japan 2026</a>
          <nav>
            <a href={`${base}/today`}>Today</a>
            <a href={`${base}/lodging`}>Hotels</a>
            <a href={`${base}/bookings`}>Bookings</a>
            <a href={`${base}/emergency`}>SOS</a>
          </nav>
        </header>
      )}
      <main class="container">
        <slot />
      </main>
    </div>

    <script is:inline>
      // URL token gate. Reads ?k=<token>, stores in sessionStorage so refreshes work.
      // To rotate: change EXPECTED below and re-share the URL.
      (function () {
        var EXPECTED = '7N3X9-RK8M-2QPLDC-7FH4'; // shared offline; rotate by editing this file
        var params = new URLSearchParams(window.location.search);
        var key = params.get('k');
        if (key) {
          sessionStorage.setItem('jp2026-k', key);
          try { localStorage.setItem('jp2026-k', key); } catch (e) {}
          // Strip the token from the URL for cleanliness
          var clean = window.location.pathname + window.location.hash;
          window.history.replaceState({}, '', clean);
        }
        var stored = sessionStorage.getItem('jp2026-k') || (function () { try { return localStorage.getItem('jp2026-k'); } catch (e) { return null; } })();
        if (stored !== EXPECTED) {
          document.getElementById('app-root').classList.add('hidden');
          document.getElementById('gate-fail').classList.remove('hidden');
        }
      })();
    </script>

    <script is:inline>
      // Copy-to-clipboard helper for taxi addresses
      document.addEventListener('click', function (e) {
        var btn = e.target.closest('[data-copy]');
        if (!btn) return;
        e.preventDefault();
        var text = btn.getAttribute('data-copy');
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function () {
            var orig = btn.textContent;
            btn.textContent = 'Copied ✓';
            setTimeout(function () { btn.textContent = orig; }, 1500);
          });
        }
      });
    </script>
  </body>
</html>
