---
import Layout from '../layouts/Layout.astro';
import { DAYS, LODGING, TRIP } from '../data/trip.ts';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const tokyo = LODGING.find(l => l.key === 'tokyo')!;
// First "real arrival" day is Day 1 (NRT landing), not Day 0/-1.
const arrivalDate = DAYS.find(d => d.n === 1)?.date;
// Pre-trip landing target: the lowest-numbered day (Day -1 if present, else Day 0).
const entryDay = [...DAYS].sort((a, b) => a.n - b.n)[0];
// Client-side day-routing data — keep it slim.
const DAYS_DATA = DAYS.map(d => ({ n: d.n, date: d.date, shortDate: d.shortDate, title: d.title, cluster: d.cluster }));
---

<Layout title="Home">
  <h1>🗾 Japan 2026</h1>
  <p class="hint" style="color: var(--muted); margin-top: -0.5rem;">{TRIP.start} → {TRIP.end} · 5 travelers</p>

  <section class="card" id="just-landed-banner" style="display: none; border-color: var(--accent);">
    <h2 style="margin-top: 0;">🛬 We just landed</h2>
    <ul>
      <li><strong>NEX</strong> → Shinjuku, ~80 min, ~¥13,010 (3 adult + 2 kid)</li>
      <li><strong>Airbnb:</strong> {tokyo.name}</li>
      <li><strong>EN:</strong> {tokyo.addressEn}</li>
      {tokyo.addressJa && (
        <li>
          <strong>JP:</strong> <span class="lang-ja">{tokyo.addressJa}</span>
          <button class="copy-btn" data-copy={tokyo.addressJa}>Copy</button>
        </li>
      )}
      <li><strong>Conf:</strong> <code>{tokyo.conf}</code> (Host: Skew Lines)</li>
    </ul>
  </section>

  {/* Today's trip-status card — populated client-side using Asia/Tokyo time */}
  <div id="trip-status"></div>

  <h3>Quick access</h3>
  <div class="grid-2">
    <a href={`${base}/packing`} class="card">
      <strong>🎒 Packing</strong>
      <div class="hint">Master list · pre-trip + day-of</div>
    </a>
    <a href={`${base}/lodging`} class="card">
      <strong>🏨 Hotels</strong>
      <div class="hint">Addresses (EN + JP) · conf #s · PINs</div>
    </a>
    <a href={`${base}/transit`} class="card">
      <strong>🚆 Transit</strong>
      <div class="hint">NEX · Romancecar · Shinkansen</div>
    </a>
    <a href={`${base}/bookings`} class="card">
      <strong>📋 All bookings</strong>
      <div class="hint">Status of every reservation</div>
    </a>
    <a href={`${base}/days`} class="card">
      <strong>🗾 All days</strong>
      <div class="hint">Day-by-day itinerary</div>
    </a>
    <a href={`${base}/emergency`} class="card">
      <strong>🆘 Emergency</strong>
      <div class="hint">110 · 119 · embassies · hotels</div>
    </a>
    <a href={`${base}/grandma`} class="card">
      <strong>👵 Popo view</strong>
      <div class="hint">Her flights · taxi · hotel</div>
    </a>
  </div>

  <h3>Menus &amp; wishlist</h3>
  <div class="grid-2">
    <a href={`${base}/docs/menus/tokyo`} class="card"><strong>Tokyo menu</strong></a>
    <a href={`${base}/docs/menus/kyoto`} class="card"><strong>Kyoto menu</strong></a>
    <a href={`${base}/docs/menus/hakone`} class="card"><strong>Hakone menu</strong></a>
    <a href={`${base}/docs/menus/narita`} class="card"><strong>Narita menu</strong></a>
    <a href={`${base}/docs/wishlist/tokyo`} class="card"><strong>Tokyo wishlist</strong></a>
    <a href={`${base}/docs/wishlist/kyoto`} class="card"><strong>Kyoto wishlist</strong></a>
  </div>

  <script is:inline define:vars={{ base, DAYS_DATA, tripStart: TRIP.start, tripEnd: TRIP.end, arrivalDate, entryDay }}>
    // Use Asia/Tokyo time, not UTC or device-local. The trip is in Tokyo;
    // server-rendered "today" doesn't work for a static site that may be
    // built hours/days before it's opened. Compute fresh, client-side.
    function tokyoToday() {
      // en-CA locale gives 'YYYY-MM-DD'
      return new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo' }).format(new Date());
    }

    function render() {
      var today = tokyoToday();
      var statusEl = document.getElementById('trip-status');
      var match = DAYS_DATA.find(function (d) { return d.date === today; });

      if (match) {
        statusEl.innerHTML =
          '<a href="' + base + '/days/' + match.n + '" class="card" style="border-color: var(--accent);">' +
            '<h2 style="margin-top: 0;">📅 Today · Day ' + match.n + ' — ' + match.title + '</h2>' +
            '<div class="hint">' + match.shortDate + ' · ' + match.cluster + '</div>' +
          '</a>';
      } else if (today < tripStart) {
        statusEl.innerHTML =
          '<a href="' + base + '/days/' + entryDay.n + '" class="card" style="border-color: var(--accent);">' +
            '<h2 style="margin-top: 0;">📅 Trip starts ' + tripStart + '</h2>' +
            '<div class="hint">Open Day ' + entryDay.n + ' — ' + entryDay.title + ' →</div>' +
          '</a>';
      } else if (today > tripEnd) {
        statusEl.innerHTML =
          '<div class="card">' +
            '<h2 style="margin-top: 0;">Trip complete 👋</h2>' +
            '<div class="hint">Welcome home.</div>' +
          '</div>';
      }

      // "Just landed" banner only on Day 1 (arrival) date
      if (arrivalDate && today === arrivalDate) {
        var banner = document.getElementById('just-landed-banner');
        if (banner) banner.style.display = 'block';
      }
    }

    render();
  </script>
</Layout>
